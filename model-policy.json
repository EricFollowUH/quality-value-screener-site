{
  "version": "2.2.0",
  "qualityBands": {
    "default": {"gross": [0.70, 0.40], "operating": [0.25, 0.10], "roe": 0.15},
    "Retail / e-commerce": {"gross": [0.35, 0.20], "operating": [0.08, 0.04], "roe": 0.15},
    "Consumer brands / staples": {"gross": [0.55, 0.35], "operating": [0.20, 0.10], "roe": 0.15},
    "Industrials / manufacturing": {"gross": [0.40, 0.25], "operating": [0.15, 0.08], "roe": 0.15},
    "Semiconductors / chip design": {"gross": [0.60, 0.35], "operating": [0.25, 0.10], "roe": 0.15},
    "SaaS / enterprise software": {"gross": [0.75, 0.55], "operating": [0.25, 0.12], "roe": 0.15},
    "Payment networks / financial infrastructure": {"gross": [0.60, 0.40], "operating": [0.30, 0.15], "roe": 0.15},
    "Healthcare services / hospitals": {"gross": [0.40, 0.20], "operating": [0.15, 0.08], "roe": 0.15}
  },
  "dataRequirements": {
    "growth": ["quarterRevenueGrowth"],
    "quality": ["grossMargins", "operatingMargins", "returnOnEquity"],
    "cashFlow": ["freeCashflow", "operatingCashflow", "capex"],
    "valuation": ["marketCap"],
    "risk": ["totalCash", "totalDebt"],
    "sustainability": ["operatingMargins", "quarterRevenueGrowth"]
  },
  "rules": [
    { "field": "softwareDisclosureUnclear", "op": "eq", "value": true, "caps": { "cashFlow": 3, "valuation": 3 }, "reason": "按报告经营现金流及资本开支计算；软件开发投入未单列，无法确认额外支出，现金流与估值保持中性待复核。" },
    { "field": "quoteAgeDays", "op": "gt", "value": 5, "caps": { "valuation": 3 }, "block": true, "reason": "行情超过5天未更新：保留真实时间，暂停正常排名。" },
    { "field": "recentLossHistory", "op": "eq", "value": true, "caps": { "quality": 3, "sustainability": 2 }, "block": true, "reason": "最近三个已披露年度存在亏损：当前高利润可能是周期或转折，需持续盈利专项复核。" },
    { "field": "customerLossRevenueShare", "op": "gt", "value": 0.05, "caps": { "growth": 4, "risk": 2, "sustainability": 2 }, "block": true, "reason": "已披露客户流失涉及超过5%收入：历史增长不能直接外推，暂停正常榜单资格。" },
    { "field": "cashflowReviewRequired", "op": "eq", "value": true, "caps": { "cashFlow": 2, "valuation": 3 }, "block": true, "reason": "经营现金流异常大或客户资金归属未核实：暂停现金流判断及完整排名。" },
    { "field": "unverifiedForecast", "op": "eq", "value": true, "caps": {}, "reason": "FPE预测年度、更新时间或分析师覆盖尚未核实：不作为低估依据，评分改用TTM盈利与可核实现金流。" },
    { "field": "valuationEvidenceMissing", "op": "eq", "value": true, "caps": { "valuation": 3 }, "reason": "历史盈利与可核实现金流的估值交叉证据不足：不授予强低估评级。" },
    { "field": "quarterRevenueGrowth", "op": "lt", "value": -0.1, "caps": { "growth": 2 }, "block": true, "reason": "最新可比季度营收下滑超过10%：年报高增长不代表当前仍高增长。" },
    { "field": "quarterGrowthMissing", "op": "eq", "value": true, "caps": { "growth": 3 }, "block": true, "reason": "最新季度同比缺失或超过200天：仅有年度代理，不能确认当前高增长。" },
    { "field": "leaseCoverageMissing", "op": "eq", "value": true, "caps": { "risk": 3 }, "block": true, "reason": "医疗服务租赁口径未完整核实：银行借款少不能直接认定低风险。" },
    { "field": "ownerCashCoverageMissing", "op": "eq", "value": true, "caps": { "cashFlow": 3, "valuation": 3 }, "block": true, "reason": "医疗服务股东现金口径未完整核实：需核对融资租赁本金与少数股东分配。" },
    { "field": "materialMinorityCash", "op": "eq", "value": true, "caps": { "cashFlow": 4 }, "reason": "少数股东分配占经营现金流超过20%：合并现金流不能全部归于普通股股东。" },
    { "field": "noncashReversalShare", "op": "gt", "value": 0.15, "caps": { "quality": 3, "valuation": 3 }, "block": true, "reason": "已核实非现金费用冲回对当期归母利润影响超过15%：需做正常化盈利复核。" },
    { "field": "settlementDependent", "op": "eq", "value": 1, "caps": { "risk": 2, "sustainability": 3, "valuation": 3 }, "block": true, "reason": "已核实收入明显依赖保险争议结算：付款资格、政策和回收率需专项评估。" },
    { "field": "researchNeedsRefresh", "op": "eq", "value": 1, "caps": { "quality": 3, "risk": 3 }, "block": true, "reason": "已有研究证据与当前财报期间不一致或已到期：暂停高质量资格，等待复核。" },
    { "field": "marketCap", "op": "lt", "value": 50000000, "caps": { "risk": 1, "valuation": 3 }, "block": true, "reason": "微盘股（市值低于5000万美元）：融资和流动性风险高，低倍数不等于低估。" },
    { "field": "marketCap", "op": "lt", "value": 300000000, "caps": { "risk": 2 }, "block": true, "reason": "小市值（低于3亿美元）：需专项核查成交流动性、融资与股本变化。" },
    { "field": "totalRevenue", "op": "lt", "value": 50000000, "caps": { "growth": 4, "quality": 3, "sustainability": 3 }, "block": true, "reason": "收入规模低于5000万美元：小基数增长和单年高利润率不足以证明成熟质量。" },
    { "field": "nonOperatingShare", "op": "gt", "value": 0.3, "caps": { "quality": 3, "valuation": 3 }, "block": true, "reason": "净利润明显高于经营利润：存在非经营收益信号，需核对汇兑、处置和和解，非已完成扣非。" },
    { "field": "totalEquity", "op": "lte", "value": 0, "caps": { "quality": 2, "risk": 2 }, "block": true, "reason": "净资产非正：ROE失去常规解释力，不得因负负得正获高分。" },
    { "field": "equityToRevenue", "op": "lt", "value": 0.1, "caps": { "quality": 3 }, "block": true, "reason": "净资产相对收入很薄：高ROE可能由小分母放大，需要ROIC等证据复核。" },
    { "field": "operatingIncome", "op": "lte", "value": 0, "caps": { "risk": 2 }, "block": true, "reason": "经营利润非正：不能以负的杠杆比率推断低风险。" },
    { "field": "totalDebt", "op": "missing", "caps": { "risk": 2 }, "block": true, "reason": "债务口径缺失或未完整核实，不代表零债务。" },
    { "field": "capex", "op": "missing", "nonFinancial": true, "caps": { "cashFlow": 3, "valuation": 3 }, "block": true, "reason": "资本开支缺失：FCF不可完整计算，不按零支出处理。" },
    { "field": "softwareInvestmentMissing", "op": "eq", "value": true, "caps": { "cashFlow": 3, "valuation": 3 }, "block": true, "reason": "软件开发投资口径缺失：FCF可能遗漏资本化开发支出，须人工核查。" },
    { "field": "freeCashflow", "op": "missing", "nonFinancial": true, "caps": { "cashFlow": 2 }, "block": true, "reason": "自由现金流缺失：不授予强现金流评级。" },
    { "field": "forwardPE", "op": "missing", "caps": {}, "reason": "FPE缺失：估值改用可核实的历史盈利和现金流。" },
    { "field": "potentialDilution", "op": "gt", "value": 0.2, "caps": { "risk": 2, "valuation": 3 }, "block": true, "reason": "已核实潜在新增股份超过当前股本20%：需复核完全摊薄估值。" },
    { "field": "productConcentration", "op": "gt", "value": 0.5, "caps": { "risk": 2, "sustainability": 2 }, "block": true, "reason": "已核实单产品收入超过50%：产品生命周期和授权风险集中。" },
    { "field": "channelConcentration", "op": "gt", "value": 0.5, "caps": { "risk": 2, "sustainability": 2 }, "block": true, "reason": "已核实单渠道收入超过50%：渠道议价和分销风险集中。" }
  ]
}
